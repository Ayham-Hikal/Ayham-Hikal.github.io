---
// About section: short bio, education and experience.
// Edit the two arrays below; the layout updates on its own.

const education = [
  {
    degree: "B.Sc. Artificial Intelligence Engineering",
    place: "Bahçeşehir University, Istanbul",
    dates: "2022 – 2026",
    points: [
      "Capstone: multimodal emotion & sentiment analysis from video (PyTorch, AWS SageMaker), team of 4",
      "Coursework: machine learning, deep learning, computer vision, MLOps",
    ],
  },
];

const experience = [
  {
    role: "Machine Learning Intern",
    place: "ICT Hub Egypt",
    dates: "Feb – Mar 2026",
    points: [
      "learned and enhanced my knowledge about ML different algorithms.",
      "Built an AI model for Houses prices sueggestion.",
    ],
  },
];
---

<section id="about" class="w-full py-12 border-t border-[#ffffff10]">
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">Get to know me</h2>
    <h3 class="text-4xl md:text-5xl font-medium text-[var(--white)] mb-6">
      About
    </h3>

    <p class="text-[var(--white-icon)] text-lg max-w-3xl mb-12">
      I'm an Egyptian AI Engineering graduate based in Türkiye. I build
      perception systems: models that let machines see and understand the world.
      Right now I'm learning robotics hands-on and comparing two fields, automotive
      and medical robotics, before starting an MSc in Robotics in Germany.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div>
        <h4 class="text-2xl text-[var(--white)] mb-4">Education</h4>
        <div class="space-y-4">
          {education.map((item) => (
            <div class="bg-[#1414149c] border border-[var(--white-icon-tr)] rounded-2xl p-5">
              <div class="flex flex-wrap justify-between gap-2">
                <span class="text-[var(--white)] font-medium">{item.degree}</span>
                <span class="text-sm text-[var(--white-icon)]">{item.dates}</span>
              </div>
              <p class="text-[var(--sec)] text-sm mt-1">{item.place}</p>
              <ul class="mt-3 space-y-1 text-sm text-[var(--white-icon)] list-disc pl-5">
                {item.points.map((p) => <li>{p}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>

      <div>
        <h4 class="text-2xl text-[var(--white)] mb-4">Experience</h4>
        <div class="space-y-4">
          {experience.map((item) => (
            <div class="bg-[#1414149c] border border-[var(--white-icon-tr)] rounded-2xl p-5">
              <div class="flex flex-wrap justify-between gap-2">
                <span class="text-[var(--white)] font-medium">{item.role}</span>
                <span class="text-sm text-[var(--white-icon)]">{item.dates}</span>
              </div>
              <p class="text-[var(--sec)] text-sm mt-1">{item.place}</p>
              <ul class="mt-3 space-y-1 text-sm text-[var(--white-icon)] list-disc pl-5">
                {item.points.map((p) => <li>{p}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
